2025-09-04 09:47:21.344 [INFO] org.extendedhl.cpp.core.ExtendedHlExtensionHandler - text: unsigned long long factorial(int n) {
    if (n < 0) {
        printf("Error: Negative input\n");
        return 0;
    }
    if (n == 0 || n == 1) {
        return 1;
    }
    unsigned long long result = 1;
    for (int i = 2; i <= n; i++) {
        result *= i;
    }
    return result;
}
