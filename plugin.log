public:
  bool needUpdate{true};
  fs::path path_;
  Header header_;
  Entries entries_;

  explicit Cacher(fs::path&& p, const std::string& v, const Flag t, const Flag f = Flag::_0BIT)
    : path_(std::move(p)), header_(), entries_() {
    if (decutc(t) < ecutc(Flag::_0BIT) || decutc(t) >= ecutc(Flag::TOTAL_COUNT)
     || decutc(f) < ecutc(Flag::_0BIT) || decutc(f) >= ecutc(Flag::TOTAL_COUNT)) {
      std::cout << "Invalid type\n";
      return;
    }
