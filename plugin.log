    if (!fs::exists(path_)) return true;
    std::ifstream is(path_, ios::binary | ios::in | ios::ate);
    if (!is.is_open()) {
      std::cout << "failed to open file: " << path_ << '\n';
      return true;
    }
    if (const size_t fileSize = is.tellg(); fileSize < Header::size()) return true;
    is.seekg(0, ios::beg);
    Header readHeader;
    is.read(reinterpret_cast<char*>(readHeader.data()), Header::size());
    if (readHeader == header_) return false;
    return true;
  }
