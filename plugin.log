enum class Flag : u8 {
  _0BIT,
  _1BIT,
  _2BIT,
  TOTAL_COUNT,
  NONE = _0BIT,

  PNG  = _1BIT,
  JSON = _2BIT,

  CHAMPION = _1BIT,
  ITEM     = _2BIT,
