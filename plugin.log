namespace fs = std::filesystem;
using std::ios;
using u8 = uint8_t;
using u16 = uint16_t;
using u32 = uint32_t;
using u64 = uint64_t;

enum class Flag : u8 {
  _0BIT,
  _1BIT,
  _2BIT,
  TOTAL_COUNT,
  NONE = _0BIT,

  PNG  = _1BIT,
  JSON = _2BIT,

  CHAMPION = _1BIT,
  ITEM     = _2BIT,
};

/**
 * @brief Converts an enumeration value to its underlying type at compile-time.
 * @tparam E The enumeration type.
 * @param e Enum value of type E to be converted.
 * @return The underlying type of the enum value.
 */
template<class E>
consteval auto ecutc(E e) noexcept -> std::underlying_type_t<E> {
  return static_cast<std::underlying_type_t<E>>(e);
}
template<class E>
auto decutc(E e) noexcept -> std::underlying_type_t<E> {
  return static_cast<std::underlying_type_t<E>>(e);
}
std::byte u8ToByte(const u8 u) noexcept {
  return static_cast<std::byte>(u);
}
std::byte FlagToByte(const Flag e) noexcept {
  return static_cast<std::byte>(decutc(e));
}

namespace {

  template<size_t N>
  using byteArray = std::array<std::byte, N>;
  using byteVector = std::vector<std::byte>;
}

std::string ByteToHex(const std::byte& b) {
  std::stringstream ss;
  ss << std::hex << std::setfill('0') << std::setw(2) << static_cast<int>(b);
  return std::string(ss.str());
}
std::string ByteToHex(const std::byte* b, const size_t size) {
  std::stringstream ss;
  for (size_t i = 0; i < size; i++)
    ss << std::hex << std::setfill('0') << std::setw(2) << static_cast<int>(*(b + i));
  return std::string(ss.str());
}

struct Header {
  std::array<std::byte, 16> bytes{};
  u8& major{*reinterpret_cast<u8*>(&bytes[0])};
  u8& minor{*reinterpret_cast<u8*>(&bytes[1])};
  u8& patch{*reinterpret_cast<u8*>(&bytes[2])};
  u8& type{*reinterpret_cast<u8*>(&bytes[4])};
  u8& extra{*reinterpret_cast<u8*>(&bytes[5])};
  u32& entryCount{*reinterpret_cast<u32*>(&bytes[8])};

  [[nodiscard]] static consteval std::size_t size() { return 16; }
  [[nodiscard]] std::byte *data() noexcept { return bytes.data(); }
  [[nodiscard]] const std::byte *data() const noexcept { return bytes.data(); }
  bool operator==(Header other) noexcept {
    return std::equal(this->data(), this->data() + size(),
                      other.data(), other.data() + size());
  }
  Header() = default;
  //explicit Header(std::array<std::byte,5>& ba)
  //  : major(ba[0]), minor(ba[1]), patch(ba[2]), type(ba[3]), extra(ba[4]) {}
};
struct Entry {
  std::vector<std::byte> data;
  std::array<std::byte, 16> bytes{};
  u32& meta{*reinterpret_cast<u32*>(&bytes[0])};
  u32& offset{*reinterpret_cast<u32*>(&bytes[4])};
  u32& size{*reinterpret_cast<u32*>(&bytes[8])};
};

struct Entries {
  byteVector data;
  u32 entryCount;
  const char pad[4];
  std::unordered_map<u32,std::pair<u32,u32>> entryMap;

  Entries() : data(), entryCount(0), pad{0,0,0,0}, entryMap() {}
  void addEntry(byteVector&& add) {
    data.reserve(data.size() + add.size());
    data.insert(data.end(), std::make_move_iterator(add.begin()), std::make_move_iterator(add.end()));
    entryCount++;
    entryMap[entryCount] = {data.size() - add.size(), add.size()};
  }
};

class Cacher {
public:
  bool needUpdate{true};
  fs::path path_;
  Header header_;
  Entries entries_;

  explicit Cacher(fs::path&& p, const std::string& v, const Flag t, const Flag f = Flag::_0BIT)
    : path_(std::move(p)), header_(), entries_() {
    if (decutc(t) < ecutc(Flag::_0BIT) || decutc(t) >= ecutc(Flag::TOTAL_COUNT)
     || decutc(f) < ecutc(Flag::_0BIT) || decutc(f) >= ecutc(Flag::TOTAL_COUNT)) {
      std::cout << "Invalid type\n";
      return;
    }
    std::array<u8,3> mmp{};
    Getmmp_(v, mmp);
    header_.major = mmp[0];
    header_.minor = mmp[1];
    header_.patch = mmp[2];
    header_.type = decutc(t);
    header_.extra = decutc(f);

    if (path_.has_parent_path() && !fs::exists(path_.parent_path())) {
      std::error_code ec;
      fs::create_directories(path_.parent_path(), ec);
      if (ec) {
        std::cout << "failed to create directory: " << path_.parent_path() << '\n';
        return;
      }
    } else {
      needUpdate = UpdateNeeded_();
    }
  }



  [[nodiscard]] size_t Write() const {
    std::fstream os(path_, ios::binary | ios::in | ios::out);
    if (!os.is_open()) {
      std::ofstream create(path_, ios::binary | ios::out);
      if (!create.is_open()) {
        std::cout << "failed to create file: " << path_ << '\n';
        return 0;
      }
      create.close();
      os.open(path_, ios::binary | ios::in | ios::out);
    }
    //os.seekp(0, ios::end);

    size_t written{0};
    os.write(
      reinterpret_cast<const char*>(header_.data()),
      Header::size()
    );
    os.flush();
    os.close();
    written += Header::size();
    return written;
  }


private:
  [[nodiscard]] bool UpdateNeeded_() const {
    if (!fs::exists(path_)) return true;
    std::ifstream is(path_, ios::binary | ios::in | ios::ate);
    if (!is.is_open()) {
      std::cout << "failed to open file: " << path_ << '\n';
      return true;
    }
    if (const size_t fileSize = is.tellg(); fileSize < Header::size()) return true;
    is.seekg(0, ios::beg);
    Header readHeader;
    is.read(reinterpret_cast<char*>(readHeader.data()), Header::size());
    if (readHeader == header_) return false;
    return true;
  }
  static void Getmmp_(const std::string& v, std::array<std::byte,3>& out) {
    std::stringstream ss(v);
    i nt unsafe_d;
    int s;
    int major, minor, patch;
    if (char dot; ss >> major >> dot >> minor >> dot >> patch) {
      if (major > UINT8_MAX || minor > UINT8_MAX || patch > UINT8_MAX) {
        std::cout << "incompatible version\n";
        return;
      }
      out[0] = static_cast<std::byte>(major);
      out[1] = static_cast<std::byte>(minor);
      out[2] = static_cast<std::byte>(patch);
    }
  }
  static void Getmmp_(const std::string& v, std::array<u8,3>& out) {
    std::stringstream ss(v);
    int major, minor, patch;
    if (char dot; ss >> major >> dot >> minor >> dot >> patch) {
      if (major > UINT8_MAX || minor > UINT8_MAX || patch > UINT8_MAX) {
        std::cout << "incompatible version\n";
        return;
      }
      out[0] = static_cast<u8>(major);
      out[1] = static_cast<u8>(minor);
      out[2] = static_cast<u8>(patch);
    }
  }
};



int main() {
  Cacher c("cache/png", "15.16.1", Flag::PNG, Flag::ITEM);
  std::cout << c.needUpdate << '\n';
  //const size_t written = c.Write();

  return 0;
}


