      if (!create.is_open()) {
        std::cout << "failed to create file: " << path_ << '\n';
        return 0;
      }
      create.close();
      os.open(path_, ios::binary | ios::in | ios::out);
    }
    //os.seekp(0, ios::end);

    size_t written{0};
    os.write(
      reinterpret_cast<const char*>(header_.data()),
      Header::size()
    );
    os.flush();
    os.close();
    written += Header::size();
    return written;
  }


private:
